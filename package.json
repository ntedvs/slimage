{
  "name": "slimage",
  "version": "0.1.2",
  "description": "Slim image - recursively optimize images in a directory using TinyPNG/Tinify",
  "keywords": [
    "cli",
    "compress",
    "image",
    "jpeg",
    "optimize",
    "png",
    "tinify",
    "tinypng",
    "webp"
  ],
  "homepage": "https://github.com/ntedvs/slimage#readme",
  "bugs": "https://github.com/ntedvs/slimage/issues",
  "license": "MIT",
  "author": "Nathaniel Davis (https://ntedvs.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntedvs/slimage.git"
  },
  "bin": {
    "slimage": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "bun src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "p-limit": "7.3.0",
    "tinify": "1.8.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
